# ── AutoX Insight X — Variables de Entorno ───────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env con credenciales reales al repositorio.

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=https://autox-insight-backend-production.up.railway.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,https://autox-insight-x.vercel.app

# ── CI/CD (GitHub Actions / Railway / Vercel) ───────────────────────────────
VERCEL_FRONTEND_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
RAILWAY_BACKEND_TOKEN=
RAILWAY_PROJECT_ID=
SONAR_TOKEN=
SUPABASE_URL_CI=
SUPABASE_SERVICE_KEY_CI=
