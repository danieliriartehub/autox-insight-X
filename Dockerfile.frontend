# ──────────────────────────────────────────────────────────
#  MEJORA: Docker multi-stage para frontend React
#  RAZÓN: Contenerizar el frontend elimina dependencias del
#         entorno local. Multi-stage reduce 10x el tamaño final
#         al separar build de runtime con nginx.
#  IMPACTO: Imagen final ~15 MB (vs ~1.5 GB con node completo).
#           Reproducibilidad total entre dev, CI y producción.
# ──────────────────────────────────────────────────────────

# ── Stage 1: Build ─────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --frozen-lockfile --ignore-scripts 2>&1 || npm ci

COPY . .
RUN npm run build

# ── Stage 2: Runtime (nginx) ──────────────────────────────
FROM nginx:stable-alpine AS runner
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
